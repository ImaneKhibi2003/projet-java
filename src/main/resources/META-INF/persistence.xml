<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="antigaspiPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.antigaspi.model.Utilisateur</class>
        <class>com.antigaspi.model.Commerce</class>
        <class>com.antigaspi.model.Panier</class>
        <class>com.antigaspi.model.Reservation</class>
        <class>com.antigaspi.model.Retrait</class>
        <class>com.antigaspi.model.Evaluation</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- H2 en mémoire (dev). schema.sql puis data.sql sont exécutés par H2 au démarrage -->
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:mem:antigaspi;MODE=MySQL;DB_CLOSE_DELAY=-1;INIT=RUNSCRIPT FROM 'classpath:schema.sql'\;RUNSCRIPT FROM 'classpath:data.sql'"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Le schéma vient de schema.sql : Hibernate ne le crée pas -->
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>

            <!-- dateDebutRetrait -> date_debut_retrait, proprietaire -> proprietaire_id -->
            <property name="hibernate.physical_naming_strategy"
                      value="org.hibernate.boot.model.naming.CamelCaseToUnderscoresNamingStrategy"/>

            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>